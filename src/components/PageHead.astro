---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<header class="wrap page-head">
  <h1 class="rise" style="--i:0">{title}</h1>
  {intro && <p class="rise" style="--i:1">{intro}</p>}
</header>

<style>
  .page-head {
    padding-top: clamp(3rem, 9vw, 5rem);
    padding-bottom: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.6rem);
    font-variation-settings: 'opsz' 72;
  }

  p {
    max-width: 32rem;
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }
</style>
