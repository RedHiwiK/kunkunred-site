---
import { t, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  project: string;
}

const { lang, project } = Astro.props;
const s = t(lang);
---

<button type="button" class="search-btn" data-search-open aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
  <span>{s.search}</span>
  <kbd class="mono">⌘K</kbd>
</button>

<dialog class="search-dialog" aria-label={s.search} data-project={project} data-bundle={withBase('/pagefind/')} data-unavailable={s.searchUnavailable}>
  <div class="search-panel" id="docs-search"></div>
</dialog>

<script>
  // Pagefind 的索引和 UI 在构建后由 `pagefind --site dist` 生成到 /pagefind/，开发模式下不存在
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog');
  let loaded: Promise<void> | null = null;

  function load() {
    if (!dialog) return Promise.resolve();
    const bundle = dialog.dataset.bundle!;
    loaded ??= new Promise<void>((resolve) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = `${bundle}pagefind-ui.css`;
      document.head.append(css);
      const js = document.createElement('script');
      js.src = `${bundle}pagefind-ui.js`;
      js.onload = () => {
        // @ts-expect-error PagefindUI is a global from pagefind-ui.js
        new PagefindUI({
          element: '#docs-search',
          bundlePath: bundle,
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          mergeFilter: { project: dialog.dataset.project },
        });
        resolve();
      };
      js.onerror = () => {
        const p = document.createElement('p');
        p.className = 'search-unavailable';
        p.textContent = dialog.dataset.unavailable ?? '';
        dialog.querySelector('#docs-search')?.append(p);
        resolve();
      };
      document.head.append(js);
    });
    return loaded;
  }

  async function open() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    await load();
    dialog.querySelector<HTMLInputElement>('input')?.focus();
  }

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      open();
    }
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    height: 2.3rem;
    padding: 0 0.7rem;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: var(--paper-raised);
    color: var(--ink-faint);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .search-btn:hover {
    border-color: var(--ink-faint);
  }

  .search-btn span {
    flex: 1;
    text-align: left;
  }

  .search-btn kbd {
    font-size: 0.6875rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--rule);
    border-radius: 5px;
  }

  .search-dialog {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100vh - 6rem));
    margin: 4rem auto auto;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-card);
  }

  .search-dialog::backdrop {
    background: color-mix(in oklch, var(--ink) 30%, transparent);
    backdrop-filter: blur(2px);
  }

  .search-panel {
    padding: 1rem;
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--seal);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper-raised);
    --pagefind-ui-border: var(--rule-strong);
    --pagefind-ui-tag: var(--paper-sunken);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 10px;
    --pagefind-ui-font: var(--font-sans);
  }

  .search-panel :global(mark) {
    background: var(--seal-soft);
    color: inherit;
  }

  .search-panel :global(.search-unavailable) {
    color: var(--ink-soft);
    font-size: 0.875rem;
  }
</style>
