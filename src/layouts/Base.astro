---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { t, href, altHref, withBase, type Lang } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 另一种语言下的对应页面，没有对应页面时传列表页 */
  altPath?: string;
  bodyClass?: string;
}

const { lang, title, description, altPath, bodyClass } = Astro.props;
const s = t(lang);
const pageTitle = title ? `${title} · ${s.siteTitle}` : `${s.siteTitle} · ${s.card.role}`;
const desc = description ?? s.siteDescription;
const alternate = altPath ?? altHref(lang, Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const zhUrl = new URL(lang === 'zh' ? Astro.url.pathname : alternate, Astro.site);
const enUrl = new URL(lang === 'en' ? Astro.url.pathname : alternate, Astro.site);
const ogImage = new URL((await getImage({ src: profile.avatar, width: 512, height: 512, format: 'png' })).src, Astro.site);
const isHome = Astro.url.pathname === href(lang, '/');
// 首页声明 Person + WebSite 结构化数据，让搜索引擎把站点和本人、GitHub 账号关联起来
const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': new URL('/#person', Astro.site).href,
          name: profile.name,
          alternateName: profile.aliases,
          url: new URL('/', Astro.site).href,
          image: ogImage.href,
          jobTitle: s.card.role,
          description: desc,
          sameAs: profile.links.filter((l) => l.url.startsWith('http')).map((l) => l.url),
        },
        {
          '@type': 'WebSite',
          name: profile.name,
          alternateName: profile.aliases,
          url: new URL('/', Astro.site).href,
          inLanguage: ['zh-CN', 'en'],
          author: { '@id': new URL('/#person', Astro.site).href },
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <link rel="alternate" type="application/rss+xml" title={s.siteTitle} href={href(lang, '/rss.xml')} />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta property="og:title" content={title ?? s.siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@RedHiwiK" />
    <meta name="author" content={profile.name} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class={bodyClass}>
    <Header lang={lang} alternate={alternate} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
