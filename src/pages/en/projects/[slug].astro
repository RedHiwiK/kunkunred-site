---
import ProjectDetail from '../../../views/ProjectDetail.astro';
import { withStars } from '../../../data/projects';

export async function getStaticPaths() {
  return (await withStars()).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectDetail lang="en" project={project} />
