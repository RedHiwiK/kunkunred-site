---
import Base from '../layouts/Base.astro';
import ProfileCard from '../components/ProfileCard.astro';
import AppCard from '../components/AppCard.astro';
import { apps } from '../data/apps';
import { principles, stack, withStars } from '../data/profile';
import { t, href, formatDate, type Lang } from '../i18n';
import { postsFor, postHref } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const repos = await withStars();
const posts = (await postsFor(lang)).slice(0, 3);
const [line1, line2] = s.statement.split('\n');
const nameChars = [...'KunKunRed'];
---

<Base lang={lang} bodyClass="home">
  <!-- ---------- 首屏 ---------- -->
  <section class="hero">
    <div class="aurora" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
    </div>
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="wrap-wide hero-grid">
      <div class="intro-copy">
        <p class="eyebrow-line mono anim" style="--t:0.25s">
          <span class="dot" aria-hidden="true"></span>{s.eyebrow}
        </p>
        <h1 class="name" aria-label="KunKunRed">
          {
            nameChars.map((c, i) => (
              <span class="mask" aria-hidden="true">
                <span class="ch" style={`--c:${i}`}>{c}</span>
              </span>
            ))
          }
        </h1>
        <p class="statement">
          <span class="anim" style="--t:0.9s">{line1}</span>
          <span class="anim faint" style="--t:1.02s">{line2}</span>
        </p>
        <p class="bio anim" style="--t:1.15s">{s.bio}</p>
        <div class="cta anim" style="--t:1.28s">
          <a href="#apps" class="btn primary">{s.ctaApps}<span aria-hidden="true">↓</span></a>
          <a href={href(lang, '/about/')} class="btn">{s.ctaAbout}</a>
        </div>
      </div>
      <div class="card-col">
        <ProfileCard lang={lang} intro />
      </div>
    </div>

    <div class="marquee anim" style="--t:1.5s" aria-hidden="true">
      <div class="track">
        {
          [0, 1].map(() => (
            <span class="row">
              {apps.map((a) => (
                <span class="item">
                  <span class="sw" style={`--accent:var(--app-${a.slug})`} />
                  {a.name[lang]}
                </span>
              ))}
              {stack.map((x) => (
                <span class="item">{x}</span>
              ))}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- 作品 ---------- -->
  <section id="apps" class="wrap-wide section">
    <header class="section-head" data-reveal>
      <div>
        <div class="kicker">01 · {s.nav.apps}</div>
        <h2>{s.appsTitle}</h2>
        <p>{s.appsLead}</p>
      </div>
    </header>
    <div class="apps-grid">
      {apps.map((app, i) => <AppCard lang={lang} app={app} index={i} />)}
    </div>
  </section>

  <!-- ---------- 开源 ---------- -->
  <section class="wrap-wide section">
    <header class="section-head" data-reveal>
      <div>
        <div class="kicker">02 · Open source</div>
        <h2>{s.openTitle}</h2>
        <p>{s.openLead}</p>
      </div>
    </header>
    <div class="repo-grid">
      {
        repos.map((r, i) => (
          <a href={`https://github.com/${r.repo}`} class="repo" target="_blank" rel="noopener" data-reveal style={`--d:${i}`}>
            <div class="repo-top">
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.71 1.71.75.75 0 0 1-1.06 1.06A2.49 2.49 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.71A2.5 2.5 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.09a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"
                />
              </svg>
              <span class="repo-name mono">{r.name}</span>
              {r.stars > 0 && (
                <span class="stars mono">
                  <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                    <path fill="currentColor" d="M8 .25a.75.75 0 0 1 .67.42l1.88 3.8 4.2.61a.75.75 0 0 1 .41 1.28l-3.04 2.96.72 4.18a.75.75 0 0 1-1.09.79L8 12.33l-3.75 1.97a.75.75 0 0 1-1.09-.8l.72-4.17L.84 6.37a.75.75 0 0 1 .42-1.28l4.19-.61L7.33.67A.75.75 0 0 1 8 .25Z" />
                  </svg>
                  {r.stars}
                </span>
              )}
            </div>
            <p>{r.desc[lang]}</p>
            <span class="go mono">GitHub ↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ---------- 关于我 ---------- -->
  <section class="wrap-wide section">
    <header class="section-head" data-reveal>
      <div>
        <div class="kicker">03 · About</div>
        <h2>{s.aboutTitle}</h2>
        <p>{s.aboutLead}</p>
      </div>
      <a href={href(lang, '/about/')} class="more">{s.aboutMore} →</a>
    </header>
    <div class="principles">
      {
        principles[lang].map((p, i) => (
          <div class="principle" data-reveal style={`--d:${i}`}>
            <span class="pn mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
    <div class="stack" data-reveal style="--d:2">
      <span class="stack-label mono">{s.stack}</span>
      <ul>
        {stack.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </section>

  <!-- ---------- 随笔 ---------- -->
  <section class="wrap-wide section">
    <header class="section-head" data-reveal>
      <div>
        <div class="kicker">04 · Writing</div>
        <h2>{s.writingTitle}</h2>
        <p>{s.writingLead}</p>
      </div>
      <a href={href(lang, '/writing/')} class="more">{s.writingMore} →</a>
    </header>
    <ul class="posts">
      {
        posts.map((p, i) => (
          <li data-reveal style={`--d:${i}`}>
            <a href={postHref(p)} class="post">
              <time class="mono" datetime={p.data.date.toISOString().slice(0, 10)}>
                {formatDate(p.data.date, lang, 'short')}
              </time>
              <span class="pt">{p.data.title}</span>
              <span class="pd">{p.data.description}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  // 作品卡片：光斑跟随指针
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>

<style>
  /* ---------- 首屏 ---------- */
  /* 首屏延伸到半透明导航栏下面，光晕不被切断 */
  .hero {
    position: relative;
    margin-top: -3.75rem;
    padding-top: calc(3.75rem + clamp(3rem, 8vw, 6rem));
    overflow: hidden;
  }

  .aurora {
    position: absolute;
    inset: -10% -10% auto;
    height: 46rem;
    z-index: -1;
    pointer-events: none;
    animation: fade 2.2s var(--ease-out) both;
  }

  .blob {
    position: absolute;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.32;
  }

  .b1 {
    left: 52%;
    top: -6rem;
    background: var(--app-vitae);
    animation: drift1 22s ease-in-out infinite alternate;
  }

  .b2 {
    left: 70%;
    top: 8rem;
    background: var(--app-cutepet);
    animation: drift2 26s ease-in-out infinite alternate;
  }

  .b3 {
    left: 38%;
    top: 14rem;
    background: var(--app-moonlog);
    opacity: 0.22;
    animation: drift3 30s ease-in-out infinite alternate;
  }

  @keyframes drift1 {
    to {
      transform: translate(-8rem, 4rem) scale(1.15);
    }
  }

  @keyframes drift2 {
    to {
      transform: translate(-6rem, -5rem) scale(0.9);
    }
  }

  @keyframes drift3 {
    to {
      transform: translate(10rem, -3rem) scale(1.1);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(var(--rule-strong) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(70% 60% at 50% 30%, black, transparent 75%);
    opacity: 0.55;
    animation: fade 1.6s var(--ease-out) both;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .anim {
    animation: blur-in 1s var(--ease-out) both;
    animation-delay: var(--t, 0s);
  }

  @keyframes blur-in {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(8px);
    }
  }

  .eyebrow-line {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in oklch, var(--paper-raised) 70%, transparent);
    backdrop-filter: blur(6px);
    color: var(--ink-soft);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--seal);
    box-shadow: 0 0 0 4px var(--seal-soft);
  }

  .name {
    display: flex;
    margin-top: 1.4rem;
    font-size: clamp(3.4rem, 10.5vw, 7.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 72;
  }

  /* 只在上下方向裁切（给字母升起动画做遮罩），左右放开，避免斜体 Red 的笔画被切掉 */
  .mask {
    display: inline-block;
    clip-path: inset(0 -0.5em);
    padding: 0.06em 0.01em 0.14em;
    margin-bottom: -0.14em;
  }

  .ch {
    display: inline-block;
    animation: char-in 1.1s var(--spring) both;
    animation-delay: calc(0.35s + var(--c) * 0.045s);
  }

  /* 斜体 R 的左下衬线会探到前一个字母下面，留一点间距 */
  .mask:nth-child(7) {
    margin-left: 0.06em;
  }

  /* 名字里的 Red 用印章红 */
  .mask:nth-child(n + 7) .ch {
    color: var(--seal);
    font-style: italic;
  }

  @keyframes char-in {
    from {
      transform: translateY(110%) rotate(10deg);
    }
  }

  .statement {
    display: grid;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    line-height: 1.35;
    font-variation-settings: 'opsz' 36;
  }

  .faint {
    color: var(--ink-faint);
  }

  .bio {
    max-width: 36rem;
    margin-top: 1.4rem;
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.9rem;
    padding: 0 1.3rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: color-mix(in oklch, var(--paper-raised) 80%, transparent);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      transform 0.45s var(--spring),
      border-color 0.2s;
  }

  .btn:hover {
    border-color: var(--ink-faint);
    transform: translateY(-2px);
  }

  .btn:active {
    transform: scale(0.96);
  }

  .btn.primary {
    border-color: transparent;
    background: var(--ink);
    color: var(--paper);
  }

  .btn.primary span {
    transition: transform 0.45s var(--spring);
  }

  .btn.primary:hover span {
    transform: translateY(3px);
  }

  .card-col {
    max-width: 25rem;
    width: 100%;
    justify-self: end;
  }

  /* 底部滚动条带 */
  .marquee {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding-block: 1.1rem;
    border-block: 1px solid var(--rule);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .row {
    display: flex;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-inline: 1.6rem;
    color: var(--ink-faint);
    font-family: var(--font-display);
    font-size: 1.35rem;
    white-space: nowrap;
  }

  .item::after {
    content: '✦';
    margin-left: 3.2rem;
    font-size: 0.7rem;
    color: var(--rule-strong);
  }

  .sw {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--accent);
  }

  /* ---------- 作品 ---------- */
  .apps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* ---------- 开源 ---------- */
  .repo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .repo {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.6rem 1.7rem;
    border: 1px solid var(--rule);
    border-radius: 22px;
    background: var(--paper-raised);
  }

  .repo:hover {
    border-color: var(--rule-strong);
  }

  .repo:hover .go {
    color: var(--seal);
  }

  .repo-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink-soft);
  }

  .repo-name {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--app-moonlog) 18%, transparent);
    color: var(--ink);
    font-size: 0.75rem;
  }

  .stars svg {
    color: var(--app-moonlog);
  }

  .repo p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .go {
    margin-top: auto;
    color: var(--ink-faint);
    font-size: 0.75rem;
    transition: color 0.2s;
  }

  /* ---------- 关于我 ---------- */
  .principles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .principle {
    position: relative;
    padding: 1.6rem 1.6rem 1.8rem;
    border-radius: 22px;
    background: var(--paper-sunken);
    overflow: hidden;
  }

  .pn {
    color: var(--seal);
    font-size: 0.75rem;
  }

  .principle h3 {
    margin-top: 2.4rem;
    font-size: 1.5rem;
  }

  .principle p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.25rem;
    margin-top: 1.5rem;
    padding: 1.1rem 1.4rem;
    border: 1px dashed var(--rule-strong);
    border-radius: 18px;
  }

  .stack-label {
    color: var(--ink-faint);
    font-size: 0.75rem;
  }

  .stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  /* ---------- 随笔 ---------- */
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .posts li {
    border-bottom: 1px solid var(--rule);
  }

  .post {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) minmax(0, 1.2fr) auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.5rem 0.5rem;
    transition: background-color 0.25s;
  }

  .post:hover {
    background: var(--paper-sunken);
  }

  .post time {
    color: var(--ink-faint);
  }

  .pt {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.3;
    transition: color 0.2s;
  }

  .post:hover .pt {
    color: var(--seal);
  }

  .pd {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .arrow {
    color: var(--ink-faint);
    transition: transform 0.4s var(--spring);
  }

  .post:hover .arrow {
    transform: translateX(4px);
    color: var(--seal);
  }

  /* ---------- 响应式 ---------- */
  @media (max-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .card-col {
      justify-self: start;
    }
    .apps-grid {
      grid-template-columns: 1fr;
      max-width: 32rem;
    }
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .post {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
    }
    .post time {
      grid-column: 1 / -1;
    }
    .pd {
      grid-column: 1;
    }
    .arrow {
      grid-row: 2;
      grid-column: 2;
    }
  }

  @media (max-width: 40rem) {
    .principles {
      grid-template-columns: 1fr;
    }
    .repo-grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      grid-template-columns: 1fr;
    }
  }
</style>
