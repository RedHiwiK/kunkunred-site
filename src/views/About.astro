---
import SocialIcon from '../components/SocialIcon.astro';
import Base from '../layouts/Base.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { principles, stack, profile } from '../data/profile';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);

const story =
  lang === 'zh'
    ? [
        '我是 KunKunRed，网上常用的 ID 是 RedHiwiK。',
        '后端出身，在大厂做过服务端开发。现在在一家 AI 平台做全栈，从服务端到前端都会碰。',
        '我是一个喜欢拥抱变化的人。技术更新得很快，我习惯第一时间去试新东西，好用的就留进自己的工作方式里。这几年 AI 发展得快，它也就成了我每天都在用的工具。',
        '工作之外，我喜欢把想法做出来。现在是几款 App 和一些开源工具，以后也想试试做游戏。我从开源社区受益很多，所以自己做出来的东西，能开源的也会开源。这个站就是放这些东西、也放我自己的地方。',
      ]
    : [
        "I'm KunKunRed, RedHiwiK in most places online.",
        'I started out as a backend engineer at a big tech company. These days I work full-stack at an AI platform, touching everything from servers to front ends.',
        'I like embracing change. Technology moves fast, and I tend to try new things early and keep the ones that earn a place in how I work. AI has moved fast these past few years, so it has become one of the tools I use every day.',
        'Outside work I like turning ideas into real things. Right now that means a few apps and some open-source tools; games might be next. Open source has given me a lot, so whatever I can share, I share. This site is where those things live, and where I do too.',
      ];
---

<Base lang={lang} title={s.aboutTitle}>
  <section class="wrap-wide about">
    <div class="copy">
      <div class="kicker mono rise" style="--i:0">About</div>
      <h1 class="rise" style="--i:1">{s.aboutTitle}</h1>
      <div class="story">
        {story.map((p, i) => <p class="rise" style={`--i:${i + 2}`}>{p}</p>)}
      </div>
      <div class="links rise" style="--i:6">
        {profile.links.map((l) => <a class="chip" href={l.url} target="_blank" rel="noopener"><SocialIcon platform={l.platform} size={16} />{l.label}</a>)}
      </div>
    </div>
    <div class="side rise" style="--i:2">
      <ProfileCard lang={lang} />
    </div>
  </section>

  <section class="wrap-wide section">
    <header class="section-head" data-reveal>
      <div>
        <div class="kicker">{s.principles}</div>
      </div>
    </header>
    <div class="principles">
      {
        principles[lang].map((p, i) => (
          <div class="principle" data-reveal style={`--d:${i}`}>
            <span class="pn mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap-wide section">
    <header class="section-head" data-reveal>
      <div>
        <div class="kicker">{s.stack}</div>
      </div>
    </header>
    <ul class="stack" data-reveal style="--d:1">
      {stack.map((x) => <li>{x}</li>)}
    </ul>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    padding-top: clamp(3rem, 8vw, 5.5rem);
  }

  .kicker {
    color: var(--seal);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.8rem, 8vw, 5rem);
    letter-spacing: -0.03em;
    font-variation-settings: 'opsz' 72;
  }

  .story {
    display: grid;
    gap: 1.1rem;
    margin-top: 2rem;
    max-width: 38rem;
    font-size: 1.0938rem;
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .story p:first-child {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.5;
  }

  .links {
    display: flex;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.6rem;
    padding: 0 1.15rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-weight: 500;
    transition: border-color 0.2s, color 0.2s;
  }

  .chip:hover {
    border-color: var(--seal);
    color: var(--seal);
  }

  .side {
    position: sticky;
    top: 5.5rem;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .principle {
    padding: 1.6rem 1.6rem 1.8rem;
    border-radius: 22px;
    background: var(--paper-sunken);
  }

  .pn {
    color: var(--seal);
    font-size: 0.75rem;
  }

  .principle h3 {
    margin-top: 2.4rem;
    font-size: 1.5rem;
  }

  .principle p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  @media (max-width: 60rem) {
    .about {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      max-width: 25rem;
    }
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .principles {
      grid-template-columns: 1fr;
    }
  }
</style>
