---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import { apps, appStoreUrl, type App } from '../data/apps';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  app: App;
}

const { lang, app } = Astro.props;
const s = t(lang);
const others = apps.filter((a) => a.slug !== app.slug);
---

<Base lang={lang} title={app.name[lang]} description={app.tagline[lang]}>
  <article style={`--accent:var(--app-${app.slug})`}>
    <div class="glow" aria-hidden="true"></div>
    <header class="wrap head">
      <AppIcon app={app} size={112} morph />
      <h1 class="rise" style="--i:1">{app.name[lang]}</h1>
      <p class="tagline rise" style="--i:2">{app.tagline[lang]}</p>
      <div class="actions rise" style="--i:3">
        <a class="btn primary" href={appStoreUrl(app)} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-4Zm-2.4-7.1c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4Z"></path></svg>
          {s.appStore}
        </a>
        {app.website && <a class="btn" href={app.website} target="_blank" rel="noopener">{s.website} ↗</a>}
      </div>
      <dl class="facts mono rise" style="--i:4">
        <div><dt>{s.platforms}</dt><dd>{app.platforms}</dd></div>
        <div><dt>{s.since}</dt><dd>{app.since}</dd></div>
        <div><dt>App Store</dt><dd>{s.price}</dd></div>
      </dl>
    </header>

    <section class="wrap block rise" style="--i:5">
      <p class="intro">{app.intro[lang]}</p>
    </section>

    <section class="wrap block rise" style="--i:6">
      <div class="eyebrow"><span>{s.highlights}</span></div>
      <ul class="highlights">
        {app.highlights[lang].map((h, i) => (
          <li>
            <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
            <span>{h}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap block" data-reveal>
      <div class="eyebrow"><span>{s.otherApps}</span></div>
      <div class="others">
        {others.map((o) => (
          <a href={href(lang, `/apps/${o.slug}/`)} class="other" style={`--accent:var(--app-${o.slug})`}>
            <AppIcon app={o} size={48} morph />
            <span>
              <span class="oname">{o.name[lang]}</span>
              <span class="otag">{o.tagline[lang]}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </article>
</Base>

<style>
  article {
    position: relative;
  }

  .glow {
    position: absolute;
    inset: -4rem 0 auto;
    height: 28rem;
    z-index: -1;
    background: radial-gradient(40rem 22rem at 50% 0%, color-mix(in oklch, var(--accent) 22%, transparent), transparent 70%);
    pointer-events: none;
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(3rem, 9vw, 5rem);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-variation-settings: 'opsz' 72;
  }

  .tagline {
    max-width: 30rem;
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.6rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    background: var(--paper-raised);
    font-size: 0.875rem;
    font-weight: 500;
    transition: transform 0.4s var(--spring), border-color 0.2s;
  }

  .btn:hover {
    border-color: var(--ink-faint);
  }

  .btn:active {
    transform: scale(0.96);
  }

  .btn.primary {
    border-color: transparent;
    background: var(--ink);
    color: var(--paper);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    margin: 2.25rem 0 0;
    font-size: 0.75rem;
  }

  .facts div {
    display: grid;
    gap: 0.1rem;
  }

  .facts dt {
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
  }

  .facts dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .block {
    margin-top: 3.5rem;
  }

  .intro {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.7;
    font-variation-settings: 'opsz' 24;
  }

  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .highlights li {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .highlights li:nth-child(odd) {
    padding-right: 1.25rem;
  }

  .num {
    color: var(--accent);
    padding-top: 0.15rem;
  }

  .others {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .other {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 18px;
    background: var(--paper-raised);
    transition: border-color 0.2s, translate 0.5s var(--spring);
  }

  .other:hover {
    border-color: color-mix(in oklch, var(--accent) 45%, var(--rule));
    translate: 0 -2px;
  }

  .other > span {
    display: grid;
    min-width: 0;
  }

  .oname {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .otag {
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (max-width: 34rem) {
    .others {
      grid-template-columns: 1fr;
    }
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
