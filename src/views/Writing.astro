---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { t, formatDate, type Lang } from '../i18n';
import { postsFor, postHref } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const posts = await postsFor(lang);
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const intro = s.writingLead;
---

<Base lang={lang} title={s.nav.writing}>
  <PageHead title={s.nav.writing} intro={intro} />
  <section class="wrap">
    {posts.length === 0 && <p class="empty">{s.noPosts}</p>}
    {
      years.map((year) => (
        <div class="year">
          <div class="eyebrow">
            <span>{year}</span>
          </div>
          <ul>
            {posts
              .filter((p) => p.data.date.getUTCFullYear() === year)
              .map((p, i) => (
                <li class="rise" style={`--i:${i + 2}`}>
                  <a href={postHref(p)} class="post">
                    <span class="title">
                      {p.data.title}
                      {lang === 'en' && p.lang === 'zh' && <span class="badge">{s.zhOnly}</span>}
                    </span>
                    <time class="mono" datetime={p.data.date.toISOString().slice(0, 10)}>
                      {formatDate(p.data.date, lang, 'short')}
                    </time>
                    <span class="desc">{p.data.description}</span>
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .empty {
    color: var(--ink-faint);
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
  }

  .year + .year {
    margin-top: 2.5rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1.5rem;
    padding: 1.1rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 12px;
    transition: background-color 0.2s;
  }

  .post:hover {
    background: var(--paper-sunken);
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.35;
    transition: color 0.2s;
  }

  .post:hover .title {
    color: var(--seal);
  }

  time {
    color: var(--ink-faint);
    padding-top: 0.3rem;
  }

  .desc {
    grid-column: 1 / -1;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .badge {
    margin-left: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--ink-faint);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0 0.3rem;
    vertical-align: 3px;
  }
</style>
